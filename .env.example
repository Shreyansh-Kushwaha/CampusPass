# Copy this file to .env and change the values.
PORT=3000
# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Set to "production" to enable Secure cookies (requires HTTPS).
NODE_ENV=development
# Demo administrator seeded on first launch (only used if no admin exists yet).
ADMIN_EMAIL=admin@campuspass.edu
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Campus Administrator
